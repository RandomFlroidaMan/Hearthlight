// Hearthlight data model.
// See /root/.claude/plans/replicated-growing-eclipse.md for the architecture
// this schema implements. Fields will grow as later phases land; this is the
// Phase 1 shape.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// A family account — the login unit. There are no individual user accounts;
// everyone in a household shares one family login (a name + a simple code),
// matching how this app is actually used (one shared device, or several,
// all belonging to the same family). Creating a *new* family additionally
// requires the deployment-wide bootstrap code (HEARTHLIGHT_BOOTSTRAP_CODE),
// so this one Hearthlight instance can host several families (e.g. yours
// and your brother's) without being open to strangers on the internet.
model Family {
  id        String   @id @default(cuid())
  name      String   @unique // display name, e.g. "The Fugetts" — also the login identifier
  codeHash  String // scrypt hash of the family's chosen simple code, never the code itself
  createdAt DateTime @default(now())

  characters Character[]
  campaigns  Campaign[]

  @@map("families")
}

// A saved player character. Ability scores are the real 5e values; the four
// kid-facing skills (Might/Magic/Cunning/Heart) are derived from them at
// read time rather than duplicated here.
model Character {
  id            String   @id @default(cuid())
  familyId      String
  family        Family   @relation(fields: [familyId], references: [id])
  name          String
  displayName   String? // kid-facing name, e.g. "Sneaky Scout" for Rogue
  // Which flavor-vocabulary system this character's race/class come from —
  // purely cosmetic/prompt-flavor, never changes the underlying mechanics
  // (still the same 6 ability scores, same 4 derived kid-facing skills).
  // Lets a Star Trek character and a fantasy character sit in the same
  // party (src/lib/startrek.ts mirrors src/lib/dnd.ts's shape).
  universe      String   @default("fantasy") // "fantasy" | "star-trek"
  race          String
  className     String
  level         Int      @default(1)
  strength      Int
  dexterity     Int
  constitution  Int
  intelligence  Int
  wisdom        Int
  charisma      Int
  proficiencies Json // string[] of proficient skills/saves
  equipment     Json // string[]
  spells        Json // string[]
  background    String?
  personality   String?
  appearance    String?
  readingAge    Int      @default(5) // 3 | 5 | 7 | 10
  portraitPath  String? // path under /data/images for the reference portrait
  sourceSheet   String? // original uploaded filename, if imported
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaigns CampaignCharacter[]

  @@map("characters")
}

// A reusable world/place — a preset biome (forest/mountain/coast/night via
// paletteKey) or a fully custom setting the DM built from a prompt and up to
// 5 reference images (e.g. a real turtle photo for a bog town on its back).
// Every campaign's setting is a WorldSetting row, whether picked from the
// library or created fresh from a one-off prompt at campaign-start time.
// Deliberately NOT family-scoped — every family on this deployment shares
// the same library of places, which is most of what "build stories around
// each other's adventures" means in practice: any family can start a new
// campaign in a setting another family already built out.
model WorldSetting {
  id              String   @id @default(cuid())
  name            String
  description     String // the freeform prompt / world description
  paletteKey      String? // "forest" | "mountain" | "coast" | "night" | null for custom
  // Which flavor/prompt system this place belongs to — drives which tone
  // guidance the story engine uses (src/server/storyEngine/genreFlavor.ts).
  genre           String   @default("fantasy") // "fantasy" | "star-trek"
  referenceImages Json     @default("[]") // string[] of paths under /data/images, max 5 enforced in app layer
  lastSceneImage  String? // filename of the most recently generated scene image for this setting — the fallback target if a new generation fails twice, so a failure never shows a placeholder box
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaigns Campaign[]

  @@map("world_settings")
}

model Campaign {
  id                String   @id @default(cuid())
  familyId          String
  family            Family   @relation(fields: [familyId], references: [id])
  worldSettingId    String
  worldSetting      WorldSetting @relation(fields: [worldSettingId], references: [id])
  roomCode          String    @unique // short pairing code for the story screen to join this campaign's live room
  act               String    @default("setup") // setup | journey | complication | climax | resolution
  tone              String?
  // Snapshot of the party's reading level at creation time (the youngest
  // party member's readingAge) — drives prose difficulty, roll complexity,
  // and whether the mature-combat toggle can apply. Snapshotted rather than
  // computed live so it can't shift mid-campaign if characters change.
  readingAge        Int       @default(5)
  digestSummary     String? // running summary of older scenes for long-context coherence
  unresolvedThreads Json      @default("[]")
  npcsMet           Json      @default("[]") // string[] of "Name: description" for named characters met, fed back into prompts for continuity
  status            String    @default("active") // active | ended | archived | failed (opening-beat generation errored)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  characters CampaignCharacter[]
  scenes     Scene[]
  items      Item[]
  spendLogs  SpendLog[]

  @@map("campaigns")
}

// Join table: a campaign's party. Many-to-many rather than Campaign's old
// single characterId, so the whole family can play as a party — everyone's
// character is present, and everyone rolls their own checks.
model CampaignCharacter {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id])
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([campaignId, characterId])
  @@map("campaign_characters")
}

model Scene {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  order       Int
  act         String @default("setup") // snapshot of Campaign.act when this scene was generated, so the act planner can count scenes-per-act
  prose       String
  imagePath   String?
  imagePrompt String? // the exact prompt used to generate this scene's art
  dmNotes     String?
  choices     Json // Choice[] (text, optional skill+dc, outcome text)
  rollResult  Json? // { skill, dc, raw, modifier, total, success }
  ambientTrack String?
  narrationPath String? // filename under /data/audio for this scene's TTS narration
  choiceText  String? // text of the choice that led here, null for the opening scene — used by the keepsake export
  isEnding    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([campaignId, order])
  @@map("scenes")
}

model Item {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id])
  name         String
  description  String?
  imagePath    String?
  earnedAtScene Int?
  createdAt    DateTime @default(now())

  @@map("items")
}

// campaignId is nullable: portrait generation and other setup-time spend
// happen before any campaign exists, not just during a running session.
model SpendLog {
  id         String    @id @default(cuid())
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  kind       String // "text_tokens" | "image" | "tts"
  amount     Int // tokens or image count
  costUsd    Float
  createdAt  DateTime  @default(now())

  @@map("spend_logs")
}

// Singleton row (id = "default") holding app-wide settings.
model Settings {
  id                String  @id @default("default")
  monthlyCapUsd     Float?
  defaultReadingAge Int     @default(5)
  narrationMuted    Boolean @default(false)
  ambienceMuted     Boolean @default(false)
  effectsMuted      Boolean @default(false)
  dmFudgeEnabled    Boolean @default(false)
  // Age-gated combat-lethality toggle: when on, and every party member in a
  // campaign is 10+, monster combat may include real defeat/death framed
  // simply (no gore, no blood) instead of the always-gentle default. Never
  // relaxes the human-conflict rule — conflict is still only ever with
  // fantastical monsters, regardless of this setting.
  matureCombatEnabled Boolean @default(false)

  @@map("settings")
}
