# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local sqlite db + generated art/narration cache
/data/*.db
/data/*.db-journal
/data/images/*
!/data/images/.gitkeep
/data/audio/*
!/data/audio/.gitkeep

# user-supplied ambient/sfx audio (purchased downloads — not for the repo)
/public/audio/ambient/*
!/public/audio/ambient/.gitkeep
!/public/audio/ambient/README.md
/public/audio/sfx/*
!/public/audio/sfx/.gitkeep
!/public/audio/sfx/README.md
