# Copy this file to .env and fill in real values. .env is gitignored.

# --- Database -----------------------------------------------------------
DATABASE_URL="file:./data/dev.db"

# Base directory for generated art/audio caches. Leave unset locally (it
# defaults to ./data, next to the SQLite file above). In production, point
# this — and DATABASE_URL — at the same mounted persistent volume, e.g.
# HEARTHLIGHT_DATA_DIR=/data and DATABASE_URL=file:/data/dev.db
HEARTHLIGHT_DATA_DIR=

# --- OpenAI ---------------------------------------------------------------
# Required starting in Phase 3 (art pipeline) and Phase 4 (story engine).
# Never exposed to the browser — only read by server route handlers.
OPENAI_API_KEY=

# Optional overrides for the pinned model snapshots in
# src/server/config/models.ts. Leave unset to use the defaults there.
HEARTHLIGHT_TEXT_MODEL=
HEARTHLIGHT_IMAGE_MODEL=
HEARTHLIGHT_TTS_MODEL=

# --- Cost control -----------------------------------------------------------
# Optional monthly spend cap in USD, enforced against the SpendLog table.
# Leave unset for no cap.
HEARTHLIGHT_MONTHLY_CAP_USD=
